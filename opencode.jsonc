{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "deepseek": {
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek V4 Flash",
          "variants": {
            "off": {
              "name": "关闭思考",
              "options": {
                "reasoning_effort": "none",
                "thinking": { "type": "disabled" }
              }
            },
            "low": {
              "name": "低强度",
              "options": {
                "reasoning_effort": "low",
                "thinking": { "type": "enabled" }
              }
            },
            "high": {
              "name": "高强度（默认）",
              "options": {
                "reasoning_effort": "high",
                "thinking": { "type": "enabled" }
              }
            },
            "max": {
              "name": "最大强度",
              "options": {
                "reasoning_effort": "max",
                "thinking": { "type": "enabled" }
              }
            }
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "variants": {
            "high": {
              "options": {
                "reasoning_effort": "high",
                "thinking": { "type": "enabled" }
              }
            },
            "max": {
              "options": {
                "reasoning_effort": "max",
                "thinking": { "type": "enabled" }
              }
            }
          }
        }
      }
    }
  },

  "model": "deepseek/deepseek-flash",
  "default_agent": "build",

  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "npx", "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:\\cheny\\Documents\\代码\\开发\\Case"
      ],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": ["uvx", "mcp-server-fetch"],
      "enabled": true,
      "timeout": 30000
    }
  },

  "permission": {
    "*": "ask",
    "bash": {
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "go build *": "allow",
      "go test *": "allow",
      "go vet *": "allow",
      "npm run build": "allow",
      "git push *": "deny",
      "*": "ask"
    },
    "edit": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny"
    }
  }
}